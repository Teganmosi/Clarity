# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///./leads.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=alerts@yourcompany.com

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Lead Scoring
SCORE_THRESHOLD_HIGH=80
SCORE_THRESHOLD_MEDIUM=50

# CRM Integrations (Mock)
HUBSPOT_API_KEY=your-hubspot-api-key
PIPEDRIVE_API_KEY=your-pipedrive-api-key

# Data Enrichment APIs (Sprint 1)
CLEARBIT_API_KEY=your_clearbit_key_here
APOLLO_API_KEY=your_apollo_key_here

# Job Queue (Sprint 2+)
REDIS_URL=redis://localhost:6379/0

# NVIDIA AI (Sprint 5)
NVIDIA_API_KEY=your_nvidia_nim_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SMS / Twilio (Sprint 6)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# LinkedIn (Sprint 6 - placeholder)
LINKEDIN_API_KEY=your_linkedin_api_key_placeholder

# Conversation / Handoff (Sprint 7)
CONVERSATION_HANDOFF_THRESHOLD=7.0

# Calendar / Meetings (Sprint 8)
CALENDAR_PROVIDER=mock
ZOOM_API_KEY=your_zoom_api_key_placeholder
MEETING_DURATION_MINUTES=30

# Orchestrator (Sprint 9)
ORCHESTRATOR_MODE=auto

# Learning & Optimization (Sprint 10)
LEARNING_RATE=0.01
AUTO_OPTIMIZE=false

# Network / Shared Intent Graph (Sprint 13)
NETWORK_ANALYTICS_ENABLED=true
DATA_HASH_SALT=your-random-salt-here-change-in-production

# Deal Closing (Sprint 14)
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
STRIPE_SECRET_KEY=your_stripe_secret_key
COMPANY_LEGAL_NAME=Clarity AI, Inc.

# Retention / Churn (Sprint 15)
CHURN_THRESHOLD=70
EXPANSION_THRESHOLD=80

# Global / Voice (Sprint 12)
SUPPORTED_LANGUAGES=en,es,fr,de,ja,pt,it,nl,zh
TWILIO_VOICE_SID=your_twilio_voice_sid
DEFAULT_CURRENCY=USD
