# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///./leads.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=alerts@yourcompany.com

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Lead Scoring
SCORE_THRESHOLD_HIGH=80
SCORE_THRESHOLD_MEDIUM=50

# CRM Integrations (Mock)
HUBSPOT_API_KEY=your-hubspot-api-key
PIPEDRIVE_API_KEY=your-pipedrive-api-key

# Data Enrichment APIs (Sprint 1)
CLEARBIT_API_KEY=your_clearbit_key_here
APOLLO_API_KEY=your_apollo_key_here

# Job Queue (Sprint 2+)
REDIS_URL=redis://localhost:6379/0

# NVIDIA AI (Sprint 5)
NVIDIA_API_KEY=your_nvidia_nim_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SMS / Twilio (Sprint 6)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# LinkedIn (Sprint 6 - placeholder)
LINKEDIN_API_KEY=your_linkedin_api_key_placeholder
